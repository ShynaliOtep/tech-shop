{
    "compilerOptions": {
        "target": "esnext",
        "module": "esnext",
        "lib": ["dom", "esnext"],
        "allowJs": true,
        "checkJs": false,
        "jsx": "preserve",
        "strict": true,
        "moduleResolution": "node",
        "esModuleInterop": true,
        "resolveJsonModule": true,
        "isolatedModules": true,
        "skipLibCheck": true,
        "types": ["vite/client"]
    },
    "include": ["resources/js/**/*"],
    "exclude": ["node_modules"]
}
